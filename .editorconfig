# The repo stores LF everywhere (.gitattributes normalizes text on commit), so
# new files start that way too. Prettier reads its own config for the frontend;
# this covers the editors and the files it does not format.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,ps1}]
indent_size = 4

# A trailing double space is a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
