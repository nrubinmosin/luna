    "core:window:allow-scale-factor",
    "core:window:allow-close",
    "dialog:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "allow-recommended-settings",
    "allow-settings-sync-state",
    "allow-set-settings-parent",
    "allow-set-settings-sync-on-start",
    "allow-read-account-config",
    "allow-check-account-config",
    "allow-format-account-config",
    "allow-write-account-config",
    "allow-list-accounts",
    "allow-create-account",
