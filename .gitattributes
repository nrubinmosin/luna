# Auto detect text files and perform LF normalization
* text=auto

# The Windows build runs in a Linux container (scripts/build-windows.ps1), so every
# file it rewrites comes back with LF endings. With core.autocrlf on, git wants
# CRLF in the working tree and reports those files as modified even though the
# content is byte-identical — which is enough to trip scripts/release.ps1's "working
# tree is dirty" check on the first release after any build, and to leave
# `git status` lying in every worktree until someone checks the files out again.
#
# Pin what the container writes to LF, and the two stop disagreeing. These are
# build outputs and manifests, never hand-edited on Windows, so nothing is lost
# by keeping them in the endings the toolchain already produces.
src-tauri/Cargo.toml         eol=lf
src-tauri/Cargo.lock         eol=lf
# build.rs writes these only where their text differs (tauri-build), and the
# Linux check's read-only checkout cannot be written at all: CRLF here would
# fail that build.
src-tauri/permissions/autogenerated/*  eol=lf

# The guide goes into the exe as it is checked out (mcp.rs `include_str!`), and
# agents read it whole: the same bytes from any checkout, and no CR in them.
src-tauri/src/luna_guide.md  eol=lf
# The same for the system skills Luna serves (library/system.rs `include_str!`),
# whose SHA-256 names the text a chat was served: one hash from every checkout.
src-tauri/resources/skills/** text eol=lf
# And for the system texts: role defaults and notes.
src-tauri/resources/system/** text eol=lf

# The transcript fixtures go into the tests byte for byte (`include_bytes!`), and
# one of them has CRLF endings on purpose: no conversion either way.
src-tauri/fixtures/**        -text

# libFuzzer reads a CR as part of a dictionary entry, and refuses the line.
src-tauri/fuzz/*.dict        eol=lf

# A release manifest and its detached signature, the signature over the
# manifest's exact bytes: no line-ending conversion either way.
src-tauri/src/claude/testdata/*  -text

# Git hooks run under sh, which reads a CR as part of the command.
.githooks/*                  eol=lf
scripts/*.sh                 eol=lf
